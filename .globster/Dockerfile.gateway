# syntax=docker/dockerfile:1.7

# Keep the downstream release path isolated from upstream packaging so the
# functional patch remains easy to rebase or remove.
FROM rust@sha256:443dd9a3260cf23c22fc05051dd5661dd7b4028d3d25dbaffab6563b63c3539c AS chef

ARG CARGO_CHEF_VERSION=0.1.77
ARG OPENSHELL_CARGO_VERSION=0.0.91-globster.1
ARG OPENSHELL_IMAGE_TAG=0.0.91

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    libclang-dev \
    libssl-dev \
    libz3-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN cargo install cargo-chef \
      --version "${CARGO_CHEF_VERSION}" \
      --locked

FROM chef AS planner

COPY . .

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /src/recipe.json recipe.json

# This layer changes only when Cargo manifests or the lockfile change.
RUN cargo chef cook \
      --release \
      --recipe-path recipe.json \
      --package openshell-server \
      --bin openshell-gateway \
      --features bundled-z3

COPY . .

# Match the upstream release pipeline. The version patch intentionally allows
# Cargo to refresh workspace package entries in Cargo.lock during the build.
RUN sed -i -E \
      '/^\[workspace\.package\]/,/^\[/{s/^version[[:space:]]*=[[:space:]]*".*"/version = "'"${OPENSHELL_CARGO_VERSION}"'"/}' \
      Cargo.toml \
    && OPENSHELL_IMAGE_TAG="${OPENSHELL_IMAGE_TAG}" \
      cargo build \
        --release \
        --package openshell-server \
        --bin openshell-gateway \
        --features bundled-z3 \
    && target/release/openshell-gateway --version

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e1fd250ce83d94603e9887ec991156a6c26905a6b0001039b7a43699018c0733

COPY --from=builder /src/target/release/openshell-gateway /usr/local/bin/openshell-gateway

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
